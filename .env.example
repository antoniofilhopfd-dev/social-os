# Copie para .env e preencha. Nunca versione o arquivo .env.
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# MySQL
DATABASE_URL=mysql://socialos:socialos_dev_pw@localhost:3306/socialos_dev
# Banco usado apenas pelos testes de integração (será recriado/limpo pelos testes)
TEST_DATABASE_URL=mysql://socialos:socialos_dev_pw@localhost:3306/socialos_test

# Armazenamento de arquivos (driver local). Deve ficar FORA do diretório público.
STORAGE_DIR=./storage

# Defina como true apenas atrás de proxy reverso confiável (usa X-Forwarded-For para o IP).
TRUST_PROXY=false
# Tamanho máximo de upload (MB) na biblioteca de mídia
MAX_UPLOAD_MB=50
APP_TIMEZONE=America/Sao_Paulo
