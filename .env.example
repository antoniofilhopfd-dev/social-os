# Copie para .env e preencha. Nunca versione o arquivo .env.
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# MySQL
DATABASE_URL=mysql://socialos:socialos_dev_pw@localhost:3306/socialos_dev
# Banco usado apenas pelos testes de integração (será recriado/limpo pelos testes)
TEST_DATABASE_URL=mysql://socialos:socialos_dev_pw@localhost:3306/socialos_test

# Armazenamento de arquivos (driver local). Deve ficar FORA do diretório público.
STORAGE_DIR=./storage

# Defina como true apenas atrás de proxy reverso confiável (usa X-Forwarded-For para o IP).
TRUST_PROXY=false
# Tamanho máximo de upload (MB) na biblioteca de mídia
MAX_UPLOAD_MB=50
APP_TIMEZONE=America/Sao_Paulo

# Cifra os segredos de 2FA em repouso (mín. 32 caracteres, aleatório). Gere com: openssl rand -base64 36
APP_SECRET=
# Frase para cifrar backups (mín. 12 caracteres). Guarde-a em local seguro, separado do backup.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
# Banco VAZIO e descartável usado só pelo teste de restauração (opcional; o teste é pulado sem ele)
RESTORE_TEST_DATABASE_URL=
