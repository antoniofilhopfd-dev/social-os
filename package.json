{
  "name": "social-os",
  "version": "0.1.0",
  "private": true,
  "description": "Social Media OS: gestão de operações de social media orgânico",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:status": "tsx scripts/migrate.ts status",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "assets:purge": "tsx scripts/assets-purge.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "jobs:daily": "tsx scripts/jobs-daily.ts",
    "preflight": "tsx scripts/preflight.ts",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots:e2e": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts tests/e2e/screenshots-06.spec.ts tests/e2e/screenshots-07.spec.ts tests/e2e/screenshots-08.spec.ts tests/e2e/screenshots-09.spec.ts tests/e2e/screenshots-10.spec.ts tests/e2e/screenshots-11.spec.ts tests/e2e/screenshots-12.spec.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.5",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
